{
  "mcpServers": {
    "context7": {
      "$comment": "Windows uses cmd /c which loads PATH automatically (no shell wrapper needed)",
      "command": "{{MCP_SHELL}}",
      "args": [
        "/c",
        "npx -y @upstash/context7-mcp@latest"
      ]
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "defer_loading": true
    },
    "gemini": {
      "command": "/Users/futurewave/gemini-mcp-rs/target/release/gemini-mcp",
      "args": [
        "--model",
        "gemini-3-pro-preview",
        "--debug"
      ]
    },
    "sequential-thinking": {
      "command": "{{MCP_SHELL}}",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "stitch": {
      "command": "{{MCP_SHELL}}",
      "args": [
        "/c",
        "npx -y stitch-mcp"
      ],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "YOUR_PROJECT_ID"
      }
    },
    "memory": {
      "$comment": "Persistent memory across sessions for user preferences, project context, and learned patterns",
      "command": "{{MCP_SHELL}}",
      "args": [
        "/c",
        "npx -y @modelcontextprotocol/server-memory"
      ]
    }
  }
}